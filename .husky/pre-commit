# Formatting and linting touch only staged files (lint-staged, including
# rustfmt for `.rs`). Clippy and the bindings check build whole crates, so
# they can't be narrowed to files; they run when the commit stages Rust.
npx lint-staged

if [ -z "$(git diff --cached --name-only -- '*.rs' '*Cargo.toml' Cargo.lock)" ]; then
  exit 0
fi

# `pty-process` and `newt-agent` are Unix-only (POSIX PTY primitives, askpass
# UDS, pkexec, …) and excluded from `default-members` on Windows. Mirror that
# exclusion here so the hook doesn't try to lint them on a Windows host.
case "$OSTYPE" in
  msys*|cygwin*|win32) CLIPPY_EXCLUDES="--exclude pty-process --exclude newt-agent" ;;
  *) CLIPPY_EXCLUDES="" ;;
esac
cargo clippy --workspace $CLIPPY_EXCLUDES -- -D warnings

# Regenerate tauri-specta TS bindings (host-independent via the
# `specta-bindings` feature); fail if they drift from what's staged.
cargo xtask gen-bindings >/dev/null
git diff --name-only -- src/lib/bindings.ts | if read -r; then
  echo "src/lib/bindings.ts is out of date — please re-stage:"
  echo "  src/lib/bindings.ts"
  exit 1
fi
