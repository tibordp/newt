{
  "name": "newt",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src/ docs/scenes/",
    "lint:fix": "eslint src/ docs/scenes/ --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,scss,json}' 'docs/scenes/**/*.{ts,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,scss,json}' 'docs/scenes/**/*.{ts,css}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "allotment": "^1.20.5",
    "cmdk": "^1.1.1",
    "immer": "^11.1.4",
    "monaco-editor": "^0.57.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "marked": "^18.0.14",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.1",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{css,scss,json}": [
      "prettier --write"
    ],
    "docs/scenes/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "docs/scenes/**/*.css": [
      "prettier --write"
    ]
  },
  "overrides": {
    "dompurify": "^3.4.16"
  }
}
